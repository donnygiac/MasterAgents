{
  "meta": {
    "brand_name": "Webidoo",
    "description": "Design token principali per l'implementazione della UI di Webidoo."
  },
  "colors": {
    "primary": {
      "DEFAULT": "#1D2680",
      "orange": "#FF6B00",
      "midnight": "#101442",
      "hover": "#1E17B2",
      "foreground": "#FFFFFF"
    },
    "secondary": {
      "DEFAULT": "#1E17B2",
      "light-orange": "#EA8900",
      "red": "#EA3D07",
      "foreground": "#FFFFFF"
    },
    "neutral": {
      "black": "#000000",
      "dark-gray": "#2B2B2B",
      "light-gray": "#6C6C6C"
    },
    "background": "#FFFFFF",
    "foreground": "#101442",
    "muted": "#F4F4F5",
    "accent": "#FF6B00",
    "destructive": "#EA3D07",
    "success": "#10B981"
  },
  "typography": {
    "font_family_headings": [
      "Poppins",
      "sans-serif"
    ],
    "font_family_body": [
      "Poppins",
      "sans-serif"
    ],
    "font_family_logo": [
      "Leigo",
      "cursive"
    ],
    "font_weight_bold": "700",
    "font_weight_normal": "400"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "ui": {
    "border_radius_default": "0.5rem",
    "border_radius_small": "0.25rem",
    "spacing_base_unit": "4px",
    "shadow_sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "shadow_default": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "shadow_md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "transition_duration": "150ms",
    "transition_timing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}